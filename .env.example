# Anna Maria Pierangeli - Environment Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to git!

# ============================================================================
# Blockchain Wallet Configuration
# ============================================================================

# Your wallet private key (without 0x prefix)
# WARNING: Keep this secret! Anyone with this key can access your wallet!
# Get from MetaMask: Account Details > Export Private Key
WALLET_PRIVATE_KEY=your_private_key_here_WITHOUT_0x_prefix

# ============================================================================
# RPC Endpoints (Blockchain Connectivity)
# ============================================================================

# Infura Project ID (https://infura.io/)
# Free tier: 100,000 requests/day
# Used for Ethereum and Polygon networks
INFURA_PROJECT_ID=your_infura_project_id

# Alternative: Alchemy API Key (https://www.alchemy.com/)
# Uncomment if using Alchemy instead of Infura
# ALCHEMY_API_KEY=your_alchemy_api_key

# ============================================================================
# IPFS Configuration (Decentralized Storage)
# ============================================================================

# Pinata API Keys (https://pinata.cloud/)
# Free tier: 1GB storage, unlimited requests
# Required for uploading frames and audio to IPFS
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_api_key

# Alternative: NFT.Storage API Key (https://nft.storage/)
# Uncomment if using NFT.Storage instead
# NFT_STORAGE_API_KEY=your_nft_storage_key

# ============================================================================
# Database Configuration (Optional - for News integration)
# ============================================================================

# MongoDB connection string
# Required only if using seed_anna_maria_pierangeli.py
# Local: mongodb://localhost:27017
# Cloud: mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=newsdb

# ============================================================================
# Network Selection (Default)
# ============================================================================

# Default network to use for minting
# Options: ethereum_mainnet, ethereum_sepolia, polygon_mainnet, polygon_mumbai, bsc_mainnet
# Recommendation: Start with polygon_mumbai (free testnet)
DEFAULT_NETWORK=polygon_mumbai

# ============================================================================
# NFT Contract Configuration
# ============================================================================

# Your deployed NFT contract address (with 0x prefix)
# Deploy contract first using Remix, Hardhat, or Truffle
# See examples/example_contract.sol for sample contract
NFT_CONTRACT_ADDRESS=0xYourContractAddressHere

# Path to your contract ABI JSON file
# Export from Remix after compiling, or from your deployment
CONTRACT_ABI_FILE=examples/contract_abi.json

# ============================================================================
# Processing Configuration (Optional)
# ============================================================================

# Default batch size for NFT minting (NFTs per batch)
# Smaller = safer but slower, Larger = faster but higher risk
# Recommended: 10-50
BATCH_SIZE=10

# Delay between batches (seconds)
# Helps avoid rate limits and blockchain congestion
# Recommended: 2-5 seconds
BATCH_DELAY=3.0

# Default frame extraction quality (0-100 for JPG)
# Higher = better quality but larger files
# Recommended: 85-95
FRAME_QUALITY=95

# Default audio segment duration (seconds)
# For segmented audio extraction
# Recommended: 30-60 seconds
AUDIO_SEGMENT_DURATION=30.0

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================

# Custom IPFS gateway (if not using Pinata default)
# IPFS_GATEWAY=https://gateway.pinata.cloud

# Gas price multiplier for faster transactions
# 1.0 = normal, 1.5 = 50% faster, 2.0 = 100% faster
# GAS_PRICE_MULTIPLIER=1.0

# Maximum retry attempts for failed operations
# MAX_RETRIES=3

# Enable debug logging (true/false)
# DEBUG=false

# ============================================================================
# Security Notes
# ============================================================================

# 1. NEVER share your private key or commit it to git
# 2. Use testnet first (polygon_mumbai) before mainnet
# 3. Keep your API keys secure
# 4. Rotate keys periodically
# 5. Use a dedicated wallet for NFT minting (not your main wallet)
# 6. Always verify contract addresses before minting

# ============================================================================
# Getting Started
# ============================================================================

# 1. Copy this file: cp .env.example .env
# 2. Fill in your credentials in .env
# 3. Get free testnet tokens:
#    - Polygon Mumbai: https://faucet.polygon.technology/
#    - Ethereum Sepolia: https://sepoliafaucet.com/
# 4. Test with a small clip first
# 5. Monitor gas costs before processing large films

# ============================================================================
# Quick Setup Checklist
# ============================================================================

# [ ] Created Infura account and got project ID
# [ ] Created Pinata account and got API keys
# [ ] Exported MetaMask private key
# [ ] Deployed NFT contract to testnet
# [ ] Got testnet tokens from faucet
# [ ] Copied .env.example to .env
# [ ] Filled in all required values
# [ ] Added .env to .gitignore
# [ ] Tested with: python nft_minting_system.py --check-balance

# ============================================================================
# Support
# ============================================================================

